let state = {grade:9, goal:null};

function showPage(id){
  ['home','about','sdgs','goal','work'].forEach(function(p){
    document.getElementById('page-'+p).classList.add('hidden');
  });
  document.getElementById('page-'+id).classList.remove('hidden');
  document.getElementById('navHome').classList.toggle('active', id==='home');
  document.getElementById('navAbout').classList.toggle('active', id==='about');
  window.scrollTo({top:0,behavior:'smooth'});
}
function showAbout(){ showPage('about'); }

function openGrade(g){
  state.grade = g;
  document.getElementById('sdgCrumb').innerHTML = '<b>'+g+'. Sınıf</b> > Sürdürülebilir Kalkınma Hedefleri';
  renderSDGs();
  showPage('sdgs');
}

function renderSDGs(){
  const grid = document.getElementById('sdgGrid');
  grid.innerHTML = '';
  SDGS.forEach(function(s){
    const d = document.createElement('div');
    d.className='sdg';
    d.style.background = s.color;
    d.innerHTML = '<div class="num">'+s.n+'</div><div class="name">'+s.name+'</div>';
    d.onclick = function(){ openGoal(s.n); };
    grid.appendChild(d);
  });
}

function openGoal(n){
  const s = SDGS.find(function(x){return x.n===n;});
  state.goal = s;
  document.getElementById('goalCrumb').innerHTML =
    '<b>'+state.grade+'. Sınıf</b> > <b>'+s.n+'. '+s.name+'</b>';
  document.getElementById('goalBadge').textContent = s.n;
  document.getElementById('goalTitle').textContent = s.name;
  document.getElementById('goalDesc').textContent = s.desc;
  document.getElementById('goalBanner').style.background = s.color;

  const grid = document.getElementById('worksGrid');
  grid.innerHTML = '';
  const art = [
    {t:'Eser 1', d:'Kırsal yaşamın zorluklarını ve dayanışmayı anlatan bir hikâye.', c:'#f6d7c4'},
    {t:'Eser 2', d:'Kuşaklar arası sorumluluğu ve yardımlaşmayı işleyen bir anlatı.', c:'#f3e3c8'},
    {t:'Eser 3', d:'Kent yoksulluğunu ve mahalle yaşamını ele alan bir metin.', c:'#e3d9cc'}
  ];
  art.forEach(function(a){
    const card = document.createElement('div');
    card.className='work';
    card.innerHTML =
      '<div class="thumb" style="background:'+a.c+'"></div>'+
      '<div class="body"><h3>'+a.t+'</h3><p>'+a.d+'</p>'+
      '<button class="btn red">Detayları Gör</button></div>';
    card.querySelector('button').onclick = function(){ openWork(a.t); };
    grid.appendChild(card);
  });

  showPage('goal');
}

function openWork(title){
  const s = state.goal;
  document.getElementById('workCrumb').innerHTML =
    '<b>'+state.grade+'. Sınıf</b> > <b>'+s.n+'. '+s.name+'</b> > <b>'+title+'</b>';
  document.getElementById('workTitle').textContent = title;
  document.getElementById('workIntro').textContent = WORKS.intro;

  const acts = document.getElementById('activities');
  acts.innerHTML = '';
  ACTIVITIES.forEach(function(a){
    const d = document.createElement('div');
    d.className='act';
    d.style.background = a.c;
    d.innerHTML =
      '<div class="ic">'+a.ic+'</div><h4>'+a.t+'</h4><p>'+a.d+'</p>'+
      '<div class="go">Başla →</div>';
    d.onclick = function(){ alert('"'+a.t+'" etkinliği demo amaçlıdır.'); };
    acts.appendChild(d);
  });

  showPage('work');
}
</script>
