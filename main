<script>
"use strict";

/*
==========================================
OPTIONAL SUPABASE CLOUD CONFIGURATION
==========================================

1. Create a Supabase project.
2. Run the SQL setup provided after this code.
3. Insert your project URL and publishable key.

Without Supabase, this website still works
locally using browser storage.

Never insert a service_role or secret key.
*/

const SUPABASE_URL = "";
const SUPABASE_PUBLISHABLE_KEY = "";

let db = null;
let currentUser = null;

if(SUPABASE_URL && SUPABASE_PUBLISHABLE_KEY && window.supabase){
  db = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY
  );
}

const app = document.getElementById("app");
const STORAGE_KEY = "miras_complete_v2";

function loadLocal(){
  try{
    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
  }catch(e){
    return {};
  }
}

let data = loadLocal();
data.works ||= [];
data.questions ||= {};
data.answers ||= {};
data.results ||= [];
data.completed ||= {};

function saveLocal(){
  try{
    localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
  }catch(e){
    console.error("Storage error",e);
  }
}

function esc(value){
  return String(value ?? "").replace(/[&<>"']/g,c=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  }[c]));
}

function render(html){
  app.innerHTML = html;
  window.scrollTo({top:0,behavior:"smooth"});
}

function back(label,fn){
  return `<button class="back" onclick="${fn}">← ${esc(label)}</button>`;
}

function feedback(message,good=true){
  return `<div class="feedback ${good?"success":"error"}" role="status">${esc(message)}</div>`;
}

function uid(){
  return "w_"+Date.now()+"_"+Math.random().toString(36).slice(2,8);
}

