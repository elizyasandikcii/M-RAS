let selectedGrade = 9;
let selectedGoal = 1;
let selectedWork = null;
let currentActivity = "";
let quiz = [];
let questionIndex = 0;
let quizAnswers = [];

function allWorks(){
  return [...sampleWorks,...data.works];
}

function getWork(id){
  return allWorks().find(w=>w.id===id);
}

function visibleWorks(){
  return allWorks().filter(w=>
    w.grade===selectedGrade &&
    w.goal===selectedGoal &&
    w.published
  );
}

function home(){
  render(`
    <section class="hero">
      <h1>Edebî Metinlerden<br>Sürdürülebilir Bir Geleceğe</h1>
      <p class="hero-subtitle">
        Türk edebiyatının zengin mirasıyla,<br>
        sürdürülebilir kalkınma hedeflerini keşfet, düşün, çözüm üret.
      </p>
      <div class="grade-grid">
        ${[9,10,11].map(g=>`
          <button class="grade-card grade${g}" onclick="chooseGrade(${g})">
            <h2>${g}. Sınıf</h2>
            <div class="book">📖</div>
            <span class="arrow">➜</span>
          </button>
        `).join("")}
      </div>
      <div class="landscape" aria-hidden="true">
        <div class="city">🌳 🌲 🌿 🏙️ 🌳 🌬️ 🌲 🌳</div>
        <div class="book-bottom">📖</div>
      </div>
    </section>
  `);
}

function chooseGrade(g){
  selectedGrade=g;
  render(`
    <div class="page">
      ${back("Ana Sayfa","home()")}
      <div class="center">
        <p class="muted">${g}. Sınıf</p>
        <h2>Sürdürülebilir Kalkınma Hedefleri</h2>
        <p>İncelemek istediğin hedefi seç.</p>
      </div>
      <div class="sdg-grid">
        ${goals.map((goal,i)=>`
          <button class="sdg-card"
            style="background:${goal[1]}"
            onclick="chooseGoal(${i+1})">
            <span class="sdg-number">${i+1}</span>
            <span class="sdg-icon">${goal[2]}</span>
            <span class="sdg-title">${goal[0]}</span>
          </button>
        `).join("")}
      </div>
    </div>
  `);
}

function chooseGoal(g){
  selectedGoal=g;
  const info=goals[g-1];
  const works=visibleWorks();

  render(`
    <div class="page">
      ${back(selectedGrade+". Sınıf","chooseGrade(selectedGrade)")}
      <div class="banner" style="background:${info[1]}18">
        <div class="banner-symbol" style="background:${info[1]}">
          ${g}<span>${info[2]}</span>
        </div>
        <div>
          <h1>${info[0]}</h1>
          <p>${info[3]}</p>
        </div>
      </div>
      <h2>Bu hedefle ilişkili edebî ürünler</h2>
      <p class="muted">İncelemek istediğin eseri seç.</p>
      ${works.length?`
        <div class="grid works-grid">
          ${works.map(w=>`
            <article class="card work-card">
              <div class="work-art">${esc(w.emoji||"📖")}</div>
              <h3>${esc(w.title)}</h3>
              <p class="muted">${esc(w.author)}</p>
              <p>${esc(w.description)}</p>
              <button class="primary"
                onclick="openWork('${w.id}')">
                Detayları Gör →
              </button>
            </article>
          `).join("")}
        </div>
      `:`
        <div class="card empty">
          <h3>Bu hedef için henüz eser eklenmedi.</h3>
          <p>Yönetim bölümünden yeni edebî eser eklenebilir.</p>
        </div>
      `}
    </div>
  `);
}

function openWork(id){
  selectedWork=getWork(id);
  if(!selectedWork)return home();
  const w=selectedWork;

  render(`
    <div class="page">
      ${back(goals[selectedGoal-1][0],"chooseGoal(selectedGoal)")}
      <p class="muted small">
        ${selectedGrade}. Sınıf › ${goals[selectedGoal-1][0]} › ${esc(w.title)}
      </p>
      <div class="work-top">
        <div class="card work-intro">
          <div class="illustration">🌱📖</div>
          <div>
            <h2>${esc(w.title)}</h2>
            <p class="muted">${esc(w.author)}</p>
            <p>${esc(w.description)}</p>
            <button class="primary" onclick="reading()">Eseri İncele →</button>
          </div>
        </div>
        <div class="card question-panel">
          <h3>💡 Bu eserin sana düşündürdüğü sorular</h3>
          <ul>
            <li>Eserde hangi toplumsal sorunlar ele alınıyor?</li>
            <li>Karakterlerin yaşam koşulları olayları nasıl etkiliyor?</li>
            <li>Bu sorunlar günümüzde nasıl karşımıza çıkıyor?</li>
            <li>Hangi çözüm önerileri geliştirilebilir?</li>
          </ul>
        </div>
      </div>
      <h2>Bu eserle neler yapabilirsin?</h2>
      <div class="activity-grid">
        ${[
          ["analyze","🔎","Metni İncele","Metnin özelliklerini araştır.","a-blue"],
          ["reflect","💡","Düşün ve Yorumla","Görüşlerini geliştir.","a-yellow"],
          ["exercise","🍀","Etkinlik Yap","Bilgilerini uygula.","a-green"],
          ["game","🎮","Oyun ve Keşfet","Sorularla öğren.","a-purple"],
          ["solution","📝","Çözüm Üret","Yeni fikirler geliştir.","a-pink"]
        ].map(a=>`
          <button class="activity ${a[4]}"
            onclick="openActivity('${a[0]}')">
            <div class="emoji">${a[1]}</div>
            <h3>${a[2]}</h3>
            <p>${a[3]}</p>
          </button>
        `).join("")}
      </div>
      <div class="card">
        <h2>🎯 Örnek Quiz</h2>
        <p>Bu eserle ilgili öğrendiklerini test et.</p>
        <button class="primary" onclick="startQuiz()">Quize Başla →</button>
      </div>
    </div>
  `);
}

function reading(){
  const w=selectedWork;
  render(`
    <div class="page">
      ${back(w.title,`openWork('${w.id}')`)}
      <article class="card">
        <p class="muted">${esc(w.author)}</p>
        <h1>${esc(w.title)}</h1>
        <div class="reading">${esc(w.body)}</div>
        <div class="toolbar">
          <button class="primary" onclick="markRead()">
            Okumayı Tamamladım ✓
          </button>
          <button class="secondary" onclick="openActivity('analyze')">
            Metni İncele →
          </button>
        </div>
        <div id="readingMessage"></div>
      </article>
    </div>
  `);
}

async function markRead(){
  data.completed[selectedWork.id]=true;
  saveLocal();

  if(db && currentUser){
    const {error}=await db.from("miras_progress").upsert({
      user_id:currentUser.id,
      work_id:selectedWork.id,
      completed:true
    },{onConflict:"user_id,work_id"});
    if(error)console.error(error);
  }

  document.getElementById("readingMessage").innerHTML=
    feedback("Okuma tamamlandı. İlerlemen kaydedildi.");
}

const activityDefinitions={
  analyze:{
    title:"🔎 Metni İncele",
    prompt:"Metnin ana düşüncesini, karakterlerini, mekânını ve sürdürülebilir kalkınma hedefiyle ilişkisini açıkla."
  },
  reflect:{
    title:"💡 Düşün ve Yorumla",
    prompt:"Metinde anlatılan sorunların günümüzdeki karşılıklarını düşün. Görüşlerini örneklerle açıkla."
  },
  exercise:{
    title:"🍀 Etkinlik Yap",
    prompt:"Metinde ele alınan bir sorun ile gerçek yaşamdan benzer bir durumu karşılaştır. Benzerlikleri ve farklılıkları yaz."
  },
  solution:{
    title:"📝 Çözüm Üret",
    prompt:"Metindeki sorunlardan birini çözmek için okulunda veya çevrende uygulanabilecek somut bir proje önerisi geliştir."
  }
};

function openActivity(type){
  if(type==="game")return startQuiz();

  currentActivity=type;
  const info=activityDefinitions[type];
  const key=selectedWork.id+"_"+type;

  render(`
    <div class="page">
      ${back(selectedWork.title,`openWork('${selectedWork.id}')`)}
      <div class="card">
        <h2>${info.title}</h2>
        <p>${info.prompt}</p>
        <label class="field">
          Cevabın
          <textarea id="studentAnswer"
            placeholder="Cevabını buraya yaz...">${esc(data.answers[key]||"")}</textarea>
        </label>
        <button class="primary" onclick="saveAnswer()">
          Cevabımı Kaydet
        </button>
        <div id="answerMessage"></div>
      </div>
    </div>
  `);
}

async function saveAnswer(){
  const answer=document.getElementById("studentAnswer").value.trim();
  const message=document.getElementById("answerMessage");

  if(!answer){
    message.innerHTML=feedback("Lütfen önce cevap yaz.",false);
    return;
  }

  const key=selectedWork.id+"_"+currentActivity;
  data.answers[key]=answer;
  saveLocal();

  if(db && currentUser){
    const {error}=await db.from("miras_answers").upsert({
      user_id:currentUser.id,
      work_id:selectedWork.id,
      activity:currentActivity,
      answer
    },{onConflict:"user_id,work_id,activity"});
    if(error){
      message.innerHTML=feedback("Cevap bu cihazda kaydedildi, ancak buluta gönderilemedi.",false);
      return;
    }
  }

  message.innerHTML=feedback("Cevabın başarıyla kaydedildi.");
}

function startQuiz(){
  quiz=data.questions[selectedWork.id]?.length
    ?data.questions[selectedWork.id]
    :defaultQuestions;

  questionIndex=0;
  quizAnswers=[];
  renderQuestion();
}

function renderQuestion(){
  if(questionIndex>=quiz.length)return finishQuiz();

  const q=quiz[questionIndex];

  render(`
    <div class="page">
      ${back(selectedWork.title,`openWork('${selectedWork.id}')`)}
      <div class="card">
        <p class="muted">
          Soru ${questionIndex+1} / ${quiz.length}
        </p>
        <div class="progress">
          <div style="width:${questionIndex/quiz.length*100}%"></div>
        </div>
        <h2 style="margin-top:30px">${esc(q.question)}</h2>
        ${q.options.map((option,i)=>`
          <button class="option" onclick="answerQuiz(${i})">
            ${String.fromCharCode(65+i)}) ${esc(option)}
          </button>
        `).join("")}
        <div id="quizMessage"></div>
      </div>
    </div>
  `);
}

function answerQuiz(choice){
  const q=quiz[questionIndex];
  quizAnswers.push(choice);

  document.querySelectorAll(".option").forEach(b=>b.disabled=true);

  const correct=choice===q.correct;
  document.getElementById("quizMessage").innerHTML=`
    ${feedback(
      correct?"Doğru cevap!":
      "Yanlış cevap. Doğru cevap: "+q.options[q.correct],
      correct
    )}
    <button class="primary" onclick="nextQuestion()">
      Devam Et →
    </button>
  `;
}

function nextQuestion(){
  questionIndex++;
  renderQuestion();
}

async function finishQuiz(){
  const score=quiz.reduce((total,q,i)=>
    total+(quizAnswers[i]===q.correct?1:0),0
  );
  const percentage=Math.round(score/quiz.length*100);

  data.results.push({
    workId:selectedWork.id,
    title:selectedWork.title,
    score,
    total:quiz.length,
    date:new Date().toISOString()
  });
  saveLocal();

  if(db && currentUser){
    const {error}=await db.from("miras_results").insert({
      user_id:currentUser.id,
      work_id:selectedWork.id,
      score,
      total:quiz.length
    });
    if(error)console.error(error);
  }

  render(`
    <div class="page">
      <div class="card center">
        <h1>Quiz Tamamlandı! 🎉</h1>
        <h2>${score} / ${quiz.length}</h2>
        <p>Başarı Oranı: %${percentage}</p>
        <div class="progress">
          <div style="width:${percentage}%"></div>
        </div>
        <div class="toolbar" style="justify-content:center">
          <button class="primary" onclick="startQuiz()">Tekrar Dene</button>
          <button class="secondary" onclick="dashboard()">Panelime Git</button>
        </div>
      </div>
    </div>
  `);
}

async function dashboard(){
  if(db && currentUser){
    await syncProgress();
  }

  const completed=Object.values(data.completed).filter(Boolean).length;
  const results=data.results;
  const average=results.length
    ?Math.round(results.reduce((sum,r)=>sum+r.score/r.total*100,0)/results.length)
    :0;

  render(`
    <div class="page">
      <h1>Öğrenci Panelim</h1>
      <p class="muted">Öğrenme ilerlemen ve kaydedilen çalışmaların.</p>

      <div class="stats">
        <div class="card stat">
          <strong>${completed}</strong>Okunan Eser
        </div>
        <div class="card stat">
          <strong>${Object.keys(data.answers).length}</strong>Kaydedilen Cevap
        </div>
        <div class="card stat">
          <strong>%${average}</strong>Quiz Ortalaması
        </div>
      </div>

      <div class="card" style="margin-top:25px">
        <h2>Quiz Sonuçlarım</h2>
        ${results.length
          ?results.slice().reverse().map(r=>`
            <div class="item">
              <strong>${esc(r.title)}</strong>
              — ${r.score}/${r.total}
              <p class="muted small">
                ${new Date(r.date).toLocaleString("tr-TR")}
              </p>
            </div>
          `).join("")
          :"<p>Henüz quiz çözmedin.</p>"
        }
      </div>

      <div class="card" style="margin-top:25px">
        <h2>Kaydedilen Çalışmalarım</h2>
        ${Object.entries(data.answers).length
          ?Object.entries(data.answers).map(([key,value])=>`
            <div class="item">
              <strong>${esc(key)}</strong>
              <p style="white-space:pre-wrap">${esc(value)}</p>
            </div>
          `).join("")
          :"<p>Henüz cevap kaydetmedin.</p>"
        }
      </div>
    </div>
  `);
}

async function syncProgress(){
  if(!db || !currentUser)return;

  const [progress,answers,results]=await Promise.all([
    db.from("miras_progress").select("*").eq("user_id",currentUser.id),
    db.from("miras_answers").select("*").eq("user_id",currentUser.id),
    db.from("miras_results").select("*").eq("user_id",currentUser.id)
  ]);

  if(!progress.error){
    progress.data.forEach(p=>data.completed[p.work_id]=p.completed);
  }
  if(!answers.error){
    answers.data.forEach(a=>{
      data.answers[a.work_id+"_"+a.activity]=a.answer;
    });
  }
  if(!results.error){
    data.results=results.data.map(r=>({
      workId:r.work_id,
      title:getWork(r.work_id)?.title||"Eser",
      score:r.score,
      total:r.total,
      date:r.created_at
    }));
  }
  saveLocal();
}

function about(){
  render(`
    <div class="page" style="max-width:900px">
      ${back("Ana Sayfa","home()")}
      <div class="card">
        <h1>MİRAS Hakkında</h1>
