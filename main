/* ACCOUNT MANAGEMENT */

function account(){
  if(!db){
    render(`
      <div class="page" style="max-width:700px">
        <h1>Hesabım</h1>
        <div class="card">
          <h2>Yerel Kullanım Modu</h2>
          <p>
            Bu sürümde Supabase henüz yapılandırılmadı.
            Site çalışır, ancak ilerleme yalnızca bu
            tarayıcıda saklanır.
          </p>
          <button class="primary" onclick="dashboard()">
            Panelime Git
          </button>
        </div>
      </div>
    `);
    return;
  }

  if(currentUser){
    render(`
      <div class="page" style="max-width:700px">
        <h1>Hesabım</h1>
        <div class="card">
          <h2>Hoş Geldin</h2>
          <p>${esc(currentUser.email)}</p>
          <div class="toolbar">
            <button class="primary" onclick="dashboard()">Panelim</button>
            <button class="secondary" onclick="signOut()">Çıkış Yap</button>
          </div>
        </div>
      </div>
    `);
    return;
  }

  render(`
    <div class="page" style="max-width:650px">
      <h1>Öğrenci Girişi</h1>
      <div class="card">
        <label class="field">E-posta
          <input type="email" id="authEmail" autocomplete="email">
        </label>
        <label class="field">Şifre
          <input type="password" id="authPassword" autocomplete="current-password">
        </label>
        <div class="toolbar">
          <button class="primary" onclick="signIn()">Giriş Yap</button>
          <button class="secondary" onclick="signUp()">Kayıt Ol</button>
        </div>
        <div id="authMessage"></div>
      </div>
    </div>
  `);
}

async function signUp(){
  const email=document.getElementById("authEmail").value.trim();
  const password=document.getElementById("authPassword").value;
  const message=document.getElementById("authMessage");

  if(!email || password.length<6){
    message.innerHTML=feedback("Geçerli e-posta ve en az 6 karakterli şifre gir.",false);
    return;
  }

  const {data:result,error}=await db.auth.signUp({email,password});
  if(error){
    message.innerHTML=feedback(error.message,false);
    return;
  }

  currentUser=result.user;
  message.innerHTML=feedback(
    result.session
      ?"Kayıt başarılı."
      :"Kayıt oluşturuldu. E-posta doğrulaması gerekiyorsa gelen kutunu kontrol et."
  );
}

async function signIn(){
  const email=document.getElementById("authEmail").value.trim();
  const password=document.getElementById("authPassword").value;
  const {data:result,error}=await db.auth.signInWithPassword({email,password});

  if(error){
    document.getElementById("authMessage").innerHTML=feedback(error.message,false);
    return;
  }

  currentUser=result.user;
  await syncProgress();
  account();
}

async function signOut(){
  if(db)await db.auth.signOut();
  currentUser=null;
  data.answers={};
  data.results=[];
  data.completed={};
  saveLocal();
  home();
}

/* CONTENT ADMINISTRATION */

let isAdmin=false;

async function checkAdmin(){
  if(!db || !currentUser)return false;
  const {data:role,error}=await db.from("miras_admins")
    .select("user_id")
    .eq("user_id",currentUser.id)
    .maybeSingle();
  return !error && !!role;
}

async function admin(){
  if(db){
    isAdmin=await checkAdmin();
    if(!isAdmin){
      render(`
        <div class="page">
          <div class="card">
            <h2>Yönetim Erişimi</h2>
            <p>Bu bölüm yalnızca yetkili yöneticilere açıktır.</p>
            <button class="primary" onclick="account()">Hesabım</button>
          </div>
        </div>
      `);
      return;
    }
  }

  render(`
    <div class="page">
      <h1>⚙️ İçerik Yönetimi</h1>
      ${!db?`
        <div class="feedback error">
          Yerel demo modu: Burada eklenen içerikler yalnızca
          bu tarayıcıda görünür. Bu panel kimlik doğrulamasıyla korunmaz.
        </div>
      `:""}

      <div class="card">
        <h2>Yeni Edebî Eser Ekle</h2>
        <form id="workForm">
          <label class="field">Sınıf
            <select name="grade">
              ${[9,10,11].map(g=>`
                <option value="${g}">${g}. Sınıf</option>
              `).join("")}
            </select>
          </label>
          <label class="field">Sürdürülebilir Kalkınma Hedefi
            <select name="goal">
              ${goals.map((g,i)=>`
                <option value="${i+1}">${i+1} — ${g[0]}</option>
              `).join("")}
            </select>
          </label>
          <label class="field">Eser Başlığı
            <input name="title" required>
          </label>
          <label class="field">Yazar
            <input name="author">
          </label>
          <label class="field">Sembol
            <input name="emoji" value="📖">
          </label>
          <label class="field">Kısa Açıklama
            <textarea name="description"></textarea>
          </label>
          <label class="field">Eserin Tam Metni
            <textarea name="body" required style="min-height:280px"></textarea>
          </label>
          <button class="primary" type="submit">Eseri Kaydet</button>
        </form>
        <div id="adminMessage"></div>
      </div>

      <div class="card" style="margin-top:25px">
        <h2>Quiz Sorusu Ekle</h2>
        <form id="questionForm">
          <label class="field">Eser
            <select name="workId">
              ${allWorks().map(w=>`
                <option value="${esc(w.id)}">
                  ${esc(w.title)} — ${w.grade}. Sınıf / Hedef ${w.goal}
                </option>
              `).join("")}
            </select>
          </label>
          <label class="field">Soru
            <input name="question" required>
          </label>
          ${[0,1,2,3].map(i=>`
            <label class="field">${String.fromCharCode(65+i)} Şıkkı
              <input name="option${i}" required>
            </label>
          `).join("")}
          <label class="field">Doğru Cevap
            <select name="correct">
              ${[0,1,2,3].map(i=>`
                <option value="${i}">${String.fromCharCode(65+i)}</option>
              `).join("")}
            </select>
          </label>
          <button class="primary" type="submit">Soruyu Ekle</button>
        </form>
        <div id="questionMessage"></div>
      </div>

      <div class="card" style="margin-top:25px">
        <h2>Eklenen Eserler</h2>
        ${data.works.length?data.works.map(w=>`
          <div class="item">
            <strong>${esc(w.title)}</strong>
            <p class="muted">${w.grade}. Sınıf — Hedef ${w.goal}</p>
            <button class="secondary danger"
              onclick="deleteWork('${w.id}')">Sil</button>
          </div>
        `).join(""):"<p>Henüz özel eser eklenmedi.</p>"}
      </div>
    </div>
  `);
}

document.addEventListener("submit",async event=>{
  if(event.target.id==="workForm"){
    event.preventDefault();

    const f=new FormData(event.target);
    const w={
      id:uid(),
      grade:Number(f.get("grade")),
      goal:Number(f.get("goal")),
      title:String(f.get("title")).trim(),
      author:String(f.get("author")).trim(),
      emoji:String(f.get("emoji")).trim()||"📖",
      description:String(f.get("description")).trim(),
      body:String(f.get("body")).trim(),
      published:true
    };

    if(!w.title || !w.body)return;

    if(db){
      if(!await checkAdmin())return;
      const {error}=await db.from("miras_works").insert(w);
      if(error){
        document.getElementById("adminMessage").innerHTML=feedback(error.message,false);
        return;
      }
    }

    data.works.push(w);
    saveLocal();
    admin();
  }

  if(event.target.id==="questionForm"){
    event.preventDefault();

    const f=new FormData(event.target);
    const workId=String(f.get("workId"));
    const q={
      question:String(f.get("question")).trim(),
      options:[0,1,2,3].map(i=>String(f.get("option"+i)).trim()),
      correct:Number(f.get("correct"))
    };

    if(db){
      if(!await checkAdmin())return;
      const {error}=await db.from("miras_questions").insert({
        work_id:workId,
        question:q.question,
        options:q.options,
        correct:q.correct
      });
      if(error){
        document.getElementById("questionMessage").innerHTML=feedback(error.message,false);
        return;
      }
    }

    data.questions[workId] ||= [];
    data.questions[workId].push(q);
    saveLocal();
    admin();
  }
});

async function deleteWork(id){
  if(!confirm("Bu eseri silmek istediğine emin misin?"))return;

  if(db){
    if(!await checkAdmin())return;
    const {error}=await db.from("miras_works").delete().eq("id",id);
    if(error){alert(error.message);return;}
  }

  data.works=data.works.filter(w=>w.id!==id);
  delete data.questions[id];
  saveLocal();
  admin();
}

async function loadCloudContent(){
  if(!db)return;

  const [works,questions]=await Promise.all([
    db.from("miras_works").select("*"),
    db.from("miras_questions").select("*")
  ]);

  if(!works.error){
    data.works=works.data;
  }

  if(!questions.error){
    data.questions={};
    questions.data.forEach(q=>{
      data.questions[q.work_id] ||= [];
      data.questions[q.work_id].push({
        question:q.question,
        options:q.options,
        correct:q.correct
      });
    });
  }
  saveLocal();
}

async function initialize(){
  if(db){
    const {data:session}=await db.auth.getSession();
    currentUser=session.session?.user||null;

    db.auth.onAuthStateChange((event,session)=>{
      currentUser=session?.user||null;
    });

    await loadCloudContent();
    if(currentUser)await syncProgress();
  }
  home();
}

initialize();
</script>
</body>
</html>
